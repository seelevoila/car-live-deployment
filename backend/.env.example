# TTS Provider Configuration
# GPT-SoVITS is the only supported server-side speech engine.
TTS_PROVIDER=gpt-sovits

# GPT-SoVITS: per-voice seed is fixed; text-low8 is an opt-in diagnostic mode.
# Validated sampling is used unchanged. Natural delivery avoids an implicit
# temperature/speed change on clone playback.
GPT_SOVITS_LIVE_SEED_MODE=fixed
GPT_SOVITS_LIVE_DELIVERY=natural
# Prompt A/B and the conditional quality policy are documented in
# docs/LIVE_TTS_AUDIT_20260918.md. Do not treat a higher cosine score as approval.
GPT_SOVITS_LIVE_USE_PROMPT_TEXT=false
# New clones use the checked reference-delivery path by default. The global
# unchecked prompt switch above stays off; failed phrases retry then fall back.
GPT_SOVITS_CLONE_PROMPT_POLICY=checked
# Applies to new GPT-SoVITS clones only; no migration of existing voices.
# Soft resident training budget. Upload, queueing, acceptance, and restoring
# the prior live profile are additional; this is NOT a 30 s creation SLA.
GPT_SOVITS_ADAPTATION_ENABLED=true
GPT_SOVITS_ADAPTATION_SECONDS=30
GPT_SOVITS_ADAPTATION_MAX_STEPS=24
# Optional local registry for individually accepted voice weights. Paths in
# this JSON are relative to its directory; absent registry leaves base/Xilian.
# GPT_SOVITS_PROFILES_FILE=data/voice_models/profiles.json
# Optional profile speaker_aux_ref_audio_paths enables the shared scorer target;
# absent keeps native single-anchor conditioning. [] explicitly uses the scorer
# with the primary alone. Auxiliary screening uses GPT_SOVITS_AUX_SIMILARITY_THRESHOLD.

# LLM Configuration (OpenAI-compatible API)
# Configure your LLM service endpoint and credentials
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=12.0

# Data directories
UPLOAD_DIR=data/uploads
DATA_DIR=data

# Database
DATABASE_URL=sqlite:///data/car_live.db

# Live2D model path (optional, for digital avatar feature)
# LIVE2D_MODEL_ROOT=C:\path\to\your\live2d\models
# LIVE2D_MODEL_FILE=model.model3.json
