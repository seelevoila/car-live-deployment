# TTS Provider Configuration
# Use 'idextts2' for IndexTTS-2.5 HTTP service
TTS_PROVIDER=idextts2

# IndexTTS-2.5 HTTP Service Endpoint
# Deploy your TTS service separately and configure the URL here
INDEX_TTS2_URL=http://127.0.0.1:8001

# Optional: Default reference audio path for IndexTTS-2.5
# INDEX_TTS2_REF_AUDIO=data/preset_voices/default.wav

# LLM Configuration (OpenAI-compatible API)
# Configure your LLM service endpoint and credentials
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=12.0

# Data directories
UPLOAD_DIR=data/uploads
DATA_DIR=data

# Database
DATABASE_URL=sqlite:///data/car_live.db

# Live2D model path (optional, for digital avatar feature)
# LIVE2D_MODEL_ROOT=C:\path\to\your\live2d\models
# LIVE2D_MODEL_FILE=model.model3.json
